# Site settings for goldmine.sh. Copy to .env (git-ignored); shell syntax,
# sourced and exported by the script. $root is the repo directory.
GOLDMINE_KEY=72E36E2428FA0F83BD2B4A0B3602E340EC677D90   # gpg key that signs both repos
GOLDMINE_REMOTE=remote:goldmine                         # rclone remote:bucket holding the published tree
RCLONE_CONFIG=$root/rclone.conf                         # rclone config with that remote
