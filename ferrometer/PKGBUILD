# Maintainer: Roman Kivalin <roman@shl.dev>
# Pin and hash mirror ../sources (Debian side); bump both together.
pkgname=ferrometer
pkgver=0.5.0
pkgrel=2
pkgdesc='Lightweight telemetry collector: system metrics to OTLP, journald to Loki'
arch=('x86_64' 'aarch64')
url='https://github.com/rkivalin/ferrometer'
license=('MIT')
depends=('glibc' 'libgcc' 'systemd-libs')
makedepends=('rust' 'protobuf' 'pkgconf')
backup=('etc/ferrometer/config.toml')
# The release profile does its own LTO and stripping; makepkg's -flto would
# leak into ring's C objects, and there are no debug symbols to split out.
options=(!lto !debug)
source=("$pkgname-v$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e5d23eadd26685223c6d119dc0c7c093acfffe7b00cc651bad165aee69ba3f0e')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$( rustc -vV | sed -n 's/host: //p' )"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/ferrometer "$pkgdir/usr/bin/ferrometer"
  install -Dm644 examples/ferrometer.service "$pkgdir/usr/lib/systemd/system/ferrometer.service"
  install -Dm644 examples/config.toml "$pkgdir/etc/ferrometer/config.toml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
