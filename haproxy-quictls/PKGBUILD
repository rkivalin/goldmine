# Maintainer: Roman Kivalin <roman@shl.dev>
# Pins and hashes mirror ../sources (Debian side); bump both together.
pkgname=haproxy-quictls
pkgver=3.4.7
pkgrel=1
_quictls_commit=c45abed8dc4034711ee2e117573e77f8257e8f1f
pkgdesc='HAProxy with QUIC/HTTP3 via QuicTLS, Lua scripting, Prometheus metrics'
arch=('x86_64' 'aarch64')
url='https://www.haproxy.org/'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later' 'Apache-2.0')
depends=('glibc' 'lua' 'pcre2')
makedepends=('cmake')
provides=('haproxy')
conflicts=('haproxy')
backup=('etc/default/haproxy')
source=(
  "https://www.haproxy.org/download/${pkgver%.*}/src/haproxy-$pkgver.tar.gz"
  "quictls-$_quictls_commit.tar.gz::https://github.com/quictls/quictls/archive/$_quictls_commit.tar.gz"
  'haproxy.service'
  'haproxy.default'
  'haproxy.sysusers'
  'quictls-zero-bio-write.patch'
)
sha256sums=(
  'ccfd342f3724c2cd659574044d788f44e20b212467c6bd5edbbfc517a2775dca'
  '603ba27e39ea489b09cb0a7fbfc7e8ebe5b17a6cd40b9a66697f074acc0835e4'
  '0ba7882a58dee058364ef2e81daddea88ed84a0bc257af1601707cf6de50dd0d'
  'de0f389ee7b49b2db61a7e648851930a5a093e052e12564c54efa8d15c0537d9'
  'f65d9c9799d202657d381bef89236f60d8710db41ee7e9c887f73b56d2a3eb88'
  'f3552b51c2748b56bfe21cf547ff6d0b01c1b48bdbf3d37159243dbc7ad4ea75'
)

prepare() {
  # Patch paths carry the Debian component prefix quictls/, hence -p2
  patch -d "quictls-$_quictls_commit" -Np2 -i "$srcdir/quictls-zero-bio-write.patch"
}

build() {
  # QuicTLS, static; cmake install is broken upstream, stage by hand.
  cd "$srcdir/quictls-$_quictls_commit"
  cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS="$CFLAGS -ffile-prefix-map=$srcdir=." \
    -DOPENSSL_NO_SHARED=ON \
    -DOPENSSL_NO_APPS=ON \
    -DOPENSSL_NO_TESTS=ON \
    -DOPENSSL_NO_DOC=ON
  cmake --build build

  local quictls="$srcdir/quictls-install"
  mkdir -p "$quictls/lib" "$quictls/include"
  cp build/libcrypto.a build/libssl.a "$quictls/lib/"
  cp -r include/openssl "$quictls/include/"
  cp build/include/openssl/*.h "$quictls/include/openssl/"

  cd "$srcdir/haproxy-$pkgver"
  make \
    TARGET=linux-glibc \
    CFLAGS="$CFLAGS" \
    LDFLAGS="$LDFLAGS" \
    USE_PCRE2=1 \
    USE_LUA=1 \
    LUA_INC=/usr/include \
    LUA_LIB_NAME=lua \
    USE_QUIC=1 \
    USE_OPENSSL=1 \
    SSL_INC="$quictls/include" \
    SSL_LIB="$quictls/lib" \
    USE_PROMEX=1
}

check() {
  "$srcdir/haproxy-$pkgver/haproxy" -vv
}

package() {
  cd "$srcdir/haproxy-$pkgver"
  install -Dm755 haproxy "$pkgdir/usr/bin/haproxy"
  install -Dm644 doc/haproxy.1 "$pkgdir/usr/share/man/man1/haproxy.1"
  install -Dm644 "$srcdir/haproxy.service" "$pkgdir/usr/lib/systemd/system/haproxy.service"
  install -Dm644 "$srcdir/haproxy.default" "$pkgdir/etc/default/haproxy"
  install -Dm644 "$srcdir/haproxy.sysusers" "$pkgdir/usr/lib/sysusers.d/haproxy.conf"
  install -dm755 "$pkgdir/etc/haproxy"
}
