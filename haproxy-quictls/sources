# Upstream pins for haproxy-quictls. Plain key=value, no shell.
# Both entries are URL + sha256 of the downloaded file, so the same values
# can go straight into the PKGBUILD's source=/sha256sums.
#
# HAProxy: the release tarball on www.haproxy.org. Upstream publishes the hash
# next to it as <name>.tar.gz.sha256. The file name must be
# haproxy-<upstream version>.tar.gz with the version from debian/changelog.
haproxy_url=https://www.haproxy.org/download/3.4/src/haproxy-3.4.7.tar.gz
haproxy_sha256=ccfd342f3724c2cd659574044d788f44e20b212467c6bd5edbbfc517a2775dca

# QuicTLS: no release tarballs or tags, so GitHub's export of the pinned
# commit. Its content is fixed by the commit; the hash pins the bytes GitHub
# served.
quictls_url=https://github.com/quictls/quictls/archive/c45abed8dc4034711ee2e117573e77f8257e8f1f.tar.gz
quictls_sha256=603ba27e39ea489b09cb0a7fbfc7e8ebe5b17a6cd40b9a66697f074acc0835e4
